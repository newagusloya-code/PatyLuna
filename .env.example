# ─────────────────────────────────────────────────────────────────
# SleepWell API – Environment Configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
APP_NAME="SleepWell API"
DEBUG=true

# ── Database ─────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sleepwell

# ── JWT ──────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret for production!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption (AES-256-GCM) ────────────────────────────────────
# IMPORTANT: Generate once and NEVER lose it – data is unrecoverable without it.
# python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

# ── AI ───────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
